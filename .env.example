# IntradayAI Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./intradayai.db
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Market Data Mode: yfinance | live | historical | mock
#   yfinance   — real market data via yfinance (NSE, Yahoo Finance)
#   live       — real-time via Kite Connect (requires API key/secret/token)
#   historical — historical data only (for backtesting)
#   mock       — fake simulated data (development/testing only)
MARKET_DATA_MODE=yfinance

# Zerodha Kite Connect (only required for live mode)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# yfinance settings (used when MARKET_DATA_MODE=yfinance)
YF_RATE_LIMIT_REQUESTS=5
YF_RATE_LIMIT_WINDOW=1.0
YF_CACHE_TTL_QUOTES=60
YF_CACHE_TTL_BARS=300
YF_DEFAULT_UNIVERSE=NIFTY50
YF_DEFAULT_TIMEFRAME=5m
YF_MAX_REQUESTS_PER_BATCH=10

# Paper Trading
INITIAL_CAPITAL=1000000
MAX_RISK_PER_TRADE_PCT=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
MAX_SIMULTANEOUS_POSITIONS=5

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
