# IntradayAI Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./intradayai.db
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Market Data Mode: yfinance | live | historical | mock
#   yfinance   — real market data via yfinance (NSE, Yahoo Finance)
#   live       — real-time via Kite Connect (requires API key/secret/token)
#   historical — historical data only (for backtesting)
#   mock       — fake simulated data (development/testing only)
MARKET_DATA_MODE=yfinance

# Zerodha Kite Connect (only required for live mode)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# yfinance settings (used when MARKET_DATA_MODE=yfinance)
YF_RATE_LIMIT_REQUESTS=5
YF_RATE_LIMIT_WINDOW=1.0
YF_CACHE_TTL_QUOTES=60
YF_CACHE_TTL_BARS=300
YF_DEFAULT_UNIVERSE=NIFTY50
YF_DEFAULT_TIMEFRAME=5m
YF_MAX_REQUESTS_PER_BATCH=10

# Live universe selection (Phase 1): rotation_80 = ACTIVE 30 Core + 50 Rotation
# version from universe_versions/universe_members (FAIL CLOSED if unavailable).
# Keep separate from ROTATION_ENGINE_ENABLED (never schedules engine runs).
LIVE_UNIVERSE=rotation_80

# Paper Trading
INITIAL_CAPITAL=10000
MAX_RISK_PER_TRADE_PCT=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
MAX_SIMULTANEOUS_POSITIONS=10

# 24-Hour market-context experiment (additive, reversible)
#   false (default) — scanner/engine byte-identical to the pre-feature build.
#   true  — every scanned symbol ALSO computes a 24H-context SHADOW
#           recommendation (last CONTEXT_24H_WINDOW_HOURS CLOCK hours of 5m
#           candles ending at the decision candle). Recorded for comparison;
#           the current signal still drives ALL paper orders. NEVER real money.
USE_24H_CONTEXT=false
CONTEXT_24H_WINDOW_HOURS=24.0

# Server
API_HOST=0.0.0.0
API_PORT=8020
CORS_ORIGINS=["http://localhost:3005"]
